{
  "class": "air_conditioner",
  "id": "harness",
  "il": 0,
  "kind": "climate",
  "label": "Air conditioner",
  "model": "CST_570004_WW",
  "props": {
    "action": {
      "options": [
        "off",
        "idle",
        "cooling",
        "drying",
        "fan",
        "active"
      ],
      "role": "action",
      "type": "select"
    },
    "auto_dry": {
      "category": "config",
      "options": [
        "off",
        "10min",
        "30min",
        "60min",
        "smart"
      ],
      "rw": true,
      "src": {
        "tlv_tag": "0x20e"
      },
      "type": "select"
    },
    "auto_dry_remaining": {
      "category": "diagnostic",
      "class": "duration",
      "src": {
        "tlv_tag": "0x225"
      },
      "type": "number",
      "unit": "min"
    },
    "available": {
      "role": "available",
      "type": "binary"
    },
    "comfort_saving": {
      "category": "config",
      "rw": true,
      "src": {
        "tlv_tag": "0x23f"
      },
      "type": "binary"
    },
    "display": {
      "category": "config",
      "options": [
        "off",
        "50%",
        "100%"
      ],
      "rw": true,
      "src": {
        "tlv_tag": "0x21f"
      },
      "type": "select"
    },
    "energy_save": {
      "category": "config",
      "rw": true,
      "src": {
        "tlv_tag": "0x20d"
      },
      "type": "binary"
    },
    "error": {
      "category": "diagnostic",
      "src": {
        "tlv_tag": "0x221"
      },
      "type": "number"
    },
    "fan": {
      "options": [
        "auto",
        "very_low",
        "low",
        "medium",
        "high",
        "power"
      ],
      "role": "fan_speed",
      "rw": true,
      "src": {
        "tlv_tag": "0x1fa"
      },
      "type": "select"
    },
    "filter_life": {
      "category": "diagnostic",
      "class": "duration",
      "src": {
        "tlv_tag": "0x356"
      },
      "type": "number",
      "unit": "h"
    },
    "filter_remaining": {
      "category": "diagnostic",
      "series": "gauge",
      "src": {
        "tlv_tag": "0x355"
      },
      "type": "number",
      "unit": "%"
    },
    "filter_used": {
      "category": "diagnostic",
      "class": "duration",
      "series": "counter",
      "src": {
        "tlv_tag": "0x355"
      },
      "type": "number",
      "unit": "h"
    },
    "humidity": {
      "class": "humidity",
      "role": "current_humidity",
      "series": "gauge",
      "src": {
        "tlv_tag": "0x336"
      },
      "type": "number",
      "unit": "%"
    },
    "mode": {
      "options": [
        "cool",
        "dry",
        "fan_only",
        "auto"
      ],
      "role": "mode",
      "rw": true,
      "src": {
        "tlv_tag": "0x1f9"
      },
      "type": "select"
    },
    "power": {
      "role": "on",
      "rw": true,
      "src": {
        "tlv_tag": "0x1f7"
      },
      "type": "binary"
    },
    "power_draw": {
      "class": "power",
      "series": "gauge",
      "src": {
        "tlv_tag": "0x2b3"
      },
      "type": "number",
      "unit": "W"
    },
    "sleep_timer": {
      "class": "duration",
      "max": 900,
      "min": 0,
      "rw": true,
      "src": {
        "tlv_tag": "0x21a"
      },
      "step": 1,
      "type": "number",
      "unit": "min"
    },
    "swing_horizontal": {
      "role": "swing_horizontal",
      "rw": true,
      "src": {
        "tlv_tag": "0x206"
      },
      "type": "binary"
    },
    "swing_vertical": {
      "role": "swing_vertical",
      "rw": true,
      "src": {
        "tlv_tag": "0x205"
      },
      "type": "binary"
    },
    "target": {
      "max": 30,
      "min": 16,
      "role": "target_temperature",
      "rw": true,
      "src": {
        "tlv_tag": "0x1fe"
      },
      "step": 0.5,
      "type": "number",
      "unit": "°C"
    },
    "temperature": {
      "role": "current_temperature",
      "src": {
        "tlv_tag": "0x1fd"
      },
      "type": "number",
      "unit": "°C"
    },
    "wind_mode": {
      "category": "config",
      "options": [
        "off",
        "manner",
        "long_power",
        "study",
        "auto_temp"
      ],
      "rw": true,
      "type": "select"
    }
  },
  "source": "rusthinq",
  "vendor": "LG",
  "x-mqtt": {
    "reject": "rusthinq/{id}/reject",
    "set": "rusthinq/{id}/{prop}/set",
    "state": "rusthinq/{id}/{prop}"
  }
}
